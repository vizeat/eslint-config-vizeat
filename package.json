  "license": "MIT",
  "peerDependencies": {
    "eslint": ">= 9"
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "neostandard": "^0.13.0",
    "prettier": "^3.9.6",
    "typescript": "6",
    "typescript-eslint": "^8.52.0"
  },
  "scripts": {
    "lint": "eslint ./",
    "fmt": "eslint ./ --fix",
