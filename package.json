  "license": "MIT",
  "peerDependencies": {
    "eslint": ">= 9"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "neostandard": "^0.12.2",
    "pnpm": "^10.16.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "scripts": {
    "lint": "eslint ./",
    "fmt": "eslint ./ --fix",
